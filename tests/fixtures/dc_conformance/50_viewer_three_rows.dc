# One datacenter, one room, three rows.
#
# Every row carries eight racks -- numbered 1-4 and 7-10 (5 and 6 are gaps in
# the numbering, so they are simply not declared) -- and every rack is
# populated at U 7, 9, 11, 13, 15, 25, 27, 29 and 31.
#
# Comma-separated segments carry both irregularities in one range each:
# `R[1..4,7..10]` declares the racks around the gap, and the nodes are one
# stepped, segmented range: the bare id-spec `[7..15x2,25..31x2]` expands to
# the U numbers themselves, `at={id}` pins each node to that slot, and
# `id=u{id}` gives it a readable id (u7, u9, ...). So one rack line and one
# node line become 8 racks x 9 nodes, once per row.

dc DC1 name="Data Center 1"

  room ROOM1 name="Room 1"

    row A..C
      rack R[1..4,7..10] u=42
        node [7..15x2,25..31x2] id=u{id} at={id} role=server
